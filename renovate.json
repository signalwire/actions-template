{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in composite actions behind a `# renovate:` comment",
      "managerFilePatterns": [
        "/^\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "rclone/rclone"
      ],
      "minimumReleaseAge": "7 days"
    }
  ]
}
